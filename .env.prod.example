# Szablon .env dla VPS-a (Mikrus 2.1). Skopiuj na serwerze jako .env i uzupelnij.
# Plik .env jest w .gitignore - NIE trafia do repo, tworzysz go recznie na serwerze.

# --- Dostawcy AI ---
# true = plan scen i klipy powstaja lokalnie (mock planner + ffmpeg), zero kosztow.
# Zostaw true dopoki nie potwierdzisz, ze caly flow dziala na VPS.
MOCK_PROVIDER=true
FAL_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Wydajnosc (Mikrus 2.1: 1 vCPU, ~1 GB RAM) ---
# Ile lancuchow scen leci rownolegle. Domyslne 4 to 4 procesy ffmpeg naraz -
# na tej maszynie to prosta droga do OOM. 1 = wolniej, ale konczy sie sukcesem.
SEMAPHORE_LIMIT=1
# Limit na jedno wywolanie providera. Za ciasny timeout jest drozszy niz za luzny:
# fal.ai liczy za rozpoczeta generacje niezaleznie od tego, czy odbierzesz plik.
CLIP_TIMEOUT_S=900

# --- Czyszczenie danych (Faza 1.3) ---
# 10 GB dysku dzielone z systemem. Material roboczy (uploads, frames, clips)
# znika po tylu dniach; gotowe filmy w data/final zostaja i rosna - je kasuje
# dopiero uzytkownik przyciskiem "Usun". Petla chodzi w procesie aplikacji,
# pierwszy przebieg przy starcie, wiec restart = wymuszone sprzatanie.
RETENTION_DAYS=7
CLEANUP_INTERVAL_H=24

# 1 vCPU. Dwa joby naraz to dwa razy SEMAPHORE_LIMIT procesow ffmpeg, czyli
# OOM zamiast dwoch filmow. Limit dotyczy jednego uzytkownika, nie calej instancji.
MAX_ACTIVE_JOBS_PER_USER=1

# --- Adres publiczny ---
# Musi byc DOKLADNIE ten adres, ktory wpisujesz w przegladarce - stad bierze sie
# link w mailu logujacym (app/api/auth.py:74). Bez schematu https ciasteczko
# z COOKIE_SECURE=true nigdy nie doleci.
# Subdomena przypieta w panelu Mikrusa do portu 30108. Bez ukosnika na koncu.
BASE_URL=https://ai-video-generator.cytr.us

# --- Sesje ---
# Wygeneruj NA SERWERZE i nigdy nie commituj:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Zmiana tej wartosci wylogowuje wszystkich (uniewaznia podpisy ciasteczek).
SESSION_SECRET=

# --- Panel admina (Faza 2.3) ---
# Adresy po przecinku, ktore dostaja przycisk "Admin" (lista jobow wszystkich
# uzytkownikow, usuwanie, blokowanie kont). Stosowane przy kazdym starcie.
ADMIN_EMAILS=

# true wymaga HTTPS. Wlacza tez strażnika w app/main.py, ktory odmowi startu
# przy MAIL_PROVIDER=console - to jest ta ochrona, ktorej na golym http nie ma.
COOKIE_SECURE=true

# --- Mail ---
# console = link logowania wraca w odpowiedzi HTTP dla DOWOLNEGO adresu e-mail.
# Na publicznym porcie to pelny backdoor. Na produkcji: resend.
MAIL_PROVIDER=resend
RESEND_API_KEY=
# Darmowy nadawca onboarding@resend.dev wysyla WYLACZNIE na adres wlasciciela
# konta Resend - do uzytku wlasnego wystarcza. Wlasny MAIL_FROM wymaga
# zweryfikowanej domeny w panelu Resend.
# MAIL_FROM=Video Generator <no-reply@twoja-domena.pl>
