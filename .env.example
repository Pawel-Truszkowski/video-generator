FAL_KEY=your-fal-key-here
ANTHROPIC_API_KEY=your-anthropic-key-here
OPENAI_API_KEY=your-openai-key-here
MOCK_PROVIDER=true
CLIP_TIMEOUT_S=600
# Ile lancuchow scen leci rownolegle (kazdy to wlasny proces ffmpeg).
# 4 jest OK na laptopie; na 1-vCPU VPS zejdz do 1 - patrz docs/deployment.md.
SEMAPHORE_LIMIT=4

# --- Auth (Faza 2) ---

# console = link do logowania trafia do logow kontenera ORAZ do odpowiedzi HTTP.
# UWAGA: to backdoor deweloperski - kazdy moze zalogowac sie na dowolne konto.
# Nigdy nie uzywaj console na produkcji (ustaw MAIL_PROVIDER=resend).
MAIL_PROVIDER=console

# RESEND_API_KEY=re_...
# Darmowy nadawca onboarding@resend.dev wysyla tylko na adres wlasciciela konta Resend.
# Wlasny MAIL_FROM wymaga zweryfikowanej domeny.
# MAIL_FROM=Video Generator <no-reply@twoja-domena.pl>

# Uzywany do zbudowania linku w mailu (Host z requestu da sie podrobic).
BASE_URL=http://localhost:8000

# Wygeneruj: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Puste = niebezpieczny sekret deweloperski + ostrzezenie w logach.
SESSION_SECRET=

# true tylko za HTTPS (Faza 4 / Caddy). Na http://localhost musi byc false,
# inaczej przegladarka odrzuci ciasteczko sesji.
COOKIE_SECURE=false
