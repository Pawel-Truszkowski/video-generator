FAL_KEY=your-fal-key-here
ANTHROPIC_API_KEY=your-anthropic-key-here
OPENAI_API_KEY=your-openai-key-here
MOCK_PROVIDER=true
CLIP_TIMEOUT_S=600
# Ile lancuchow scen leci rownolegle (kazdy to wlasny proces ffmpeg).
# 4 jest OK na laptopie; na 1-vCPU VPS zejdz do 1 - patrz docs/deployment.md.
SEMAPHORE_LIMIT=4

# --- Czyszczenie danych (Faza 1.3) ---

# Po ilu dniach znika material roboczy joba (uploads, frames, clips).
# Gotowy film w data/final NIE jest kasowany - tylko przez DELETE /jobs/{id}.
# Ustaw 0, zeby przy najblizszym restarcie posprzatac wszystko (test retencji).
RETENTION_DAYS=7

# Co ile godzin chodzi petla sprzatajaca. Pierwszy przebieg leci zawsze przy
# starcie, wiec do testowania wystarcza restart kontenera - to jest tu po to,
# zeby dalo sie skrocic ceke bez czekania dobe.
CLEANUP_INTERVAL_H=24

# Ile jobow jednego uzytkownika moze pracowac naraz. Kazdy aktywny job to
# wlasny zestaw procesow ffmpeg i wlasny rachunek u providera.
MAX_ACTIVE_JOBS_PER_USER=3

# --- Auth (Faza 2) ---

# console = link do logowania trafia do logow kontenera ORAZ do odpowiedzi HTTP.
# UWAGA: to backdoor deweloperski - kazdy moze zalogowac sie na dowolne konto.
# Nigdy nie uzywaj console na produkcji (ustaw MAIL_PROVIDER=resend).
MAIL_PROVIDER=console

# RESEND_API_KEY=re_...
# Darmowy nadawca onboarding@resend.dev wysyla tylko na adres wlasciciela konta Resend.
# Wlasny MAIL_FROM wymaga zweryfikowanej domeny.
# MAIL_FROM=Video Generator <no-reply@twoja-domena.pl>

# Uzywany do zbudowania linku w mailu (Host z requestu da sie podrobic).
BASE_URL=http://localhost:8000

# Wygeneruj: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Puste = niebezpieczny sekret deweloperski + ostrzezenie w logach.
SESSION_SECRET=

# true tylko za HTTPS (Faza 4 / Caddy). Na http://localhost musi byc false,
# inaczej przegladarka odrzuci ciasteczko sesji.
COOKIE_SECURE=false

# --- Panel admina (Faza 2.3) ---

# Adresy po przecinku. Przy kazdym starcie trafiaja do users.is_admin; adres,
# ktory zarejestruje sie pozniej, dostaje flage przy zakladaniu konta.
ADMIN_EMAILS=
